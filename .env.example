# ==============================================================================
# YUGMA AI — ENVIRONMENT CONFIGURATION CHEATSHEET
# ==============================================================================
# Set these keys in your local .env.local file, and in your Vercel Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (Get key from: https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (From: Supabase Dashboard > Project Settings > API)
# ------------------------------------------------------------------------------
# Project URL (https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon Public Key (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Service Role Secret Key (REQUIRED for server administration, storage signed URLs, and admin audits)
# ⚠️ Keep secret! Set in Vercel Environment Variables and local .env.local only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase Storage bucket name for uploaded profile photos, palm scans & Kundli documents
# Create a private bucket named 'user-uploads' in Supabase Dashboard > Storage
STORAGE_BUCKET=user-uploads

# ------------------------------------------------------------------------------
# 3. PLATFORM & ADMINISTRATION CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated email addresses of authorized administrators for /admin portal
ADMIN_EMAILS=your-email@gmail.com,admin@yugma.ai

# Number of free analyses allowed for anonymous guests before prompting for account creation
FREE_ANALYSIS_LIMIT=20

# Maximum allowed file upload size in bytes (500 MB = 524,288,000 bytes)
MAX_UPLOAD_BYTES=524288000

# Minimum age requirement for relationship analysis (Legal default: 18)
MINIMUM_AGE=18

# Production domain URL (e.g. https://yugma.ai or https://your-project.vercel.app)
APP_URL=http://localhost:3000
